# Copy to .env and adjust for your environment.
DATABASE_PATH=./sheerwood.db
# For development, Vite proxies /api to http://localhost:8000.

# Keep this value on the server only. Never add it to a VITE_ variable or commit it.
OPENAI_API_KEY=your_openai_api_key_here
# Change this if your OpenAI project uses a different enabled model.
OPENAI_MODEL=gpt-5

# Basic protection for the public admissions chat endpoint.
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=300

# AWS SMS OTP settings. Use an IAM role on the server for AWS credentials;
# never put AWS access keys in this file or commit backend/.env.
AWS_REGION=us-east-1
OTP_SECRET_KEY=replace_with_a_long_random_secret
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_REQUESTS=3
OTP_RATE_LIMIT_WINDOW_SECONDS=3600

# API authentication. Keep AUTH_MODE=local only for the seeded local demo users.
# Cognito validates JWTs using the public JWKS endpoint; no client secret is required here.
AUTH_MODE=cognito
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_yUXks7iXD
COGNITO_CLIENT_ID=your_public_spa_app_client_id
COGNITO_ROLE_CLAIM=custom:role
COGNITO_DEFAULT_ROLE=parent

# Email OTP settings. Use an app password or SMTP credentials from your email provider.
# Keep these server-side only; never use VITE_ variables for credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=admissions@example.com
