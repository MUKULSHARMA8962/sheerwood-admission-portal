# Copy to .env and adjust for your environment.
#
# AWS RDS PostgreSQL (production): these values are read only by the FastAPI
# server. Do not add any of them to a VITE_ variable or commit backend/.env.
# The configured endpoint and default PostgreSQL port are shown below.
POSTGRES_HOST=database-1.c0164k0cckzv.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_rds_password
POSTGRES_SSLMODE=verify-full
# Download the AWS RDS global certificate bundle before using verify-full.
# In Docker, use /certs/global-bundle.pem; locally, use its actual local path.
POSTGRES_SSLROOTCERT=/certs/global-bundle.pem

# Maximum size for each PDF/JPG/PNG admission document stored in the database.
MAX_ADMISSION_DOCUMENT_BYTES=5242880

# Alternatively provide one URL instead of POSTGRES_* variables. It takes
# precedence over the individual settings and passwords must be URL-encoded.
# DATABASE_URL=postgresql://postgres:password@database-1.c0164k0cckzv.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=verify-full&sslrootcert=/certs/global-bundle.pem

# SQLite remains the local-development fallback only when no PostgreSQL setting
# above is supplied.
DATABASE_PATH=./sheerwood.db
# For development, Vite proxies /api to http://localhost:8000.

# Keep this value on the server only. Never add it to a VITE_ variable or commit it.
OPENAI_API_KEY=your_openai_api_key_here
# Change this if your OpenAI project uses a different enabled model.
OPENAI_MODEL=gpt-5

# Basic protection for the public admissions chat endpoint.
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=300

# AWS SMS OTP settings. Use an IAM role on the server for AWS credentials;
# never put AWS access keys in this file or commit backend/.env.
AWS_REGION=us-east-1
OTP_SECRET_KEY=replace_with_a_long_random_secret
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_REQUESTS=3
OTP_RATE_LIMIT_WINDOW_SECONDS=3600

# API authentication. Keep AUTH_MODE=local only for the seeded local demo users.
# Cognito validates JWTs using the public JWKS endpoint.
AUTH_MODE=cognito
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_PGsbC8UiT
COGNITO_CLIENT_ID=2oii9hos09ek2r06iasb4otbgg
COGNITO_ROLE_CLAIM=custom:role
COGNITO_DEFAULT_ROLE=admission

# Required only for a Cognito app client that has a secret. The React app sends
# the authorization code to this API; this server sends the secret to Cognito.
# Do not put this secret in .env.production or in any VITE_ variable.
COGNITO_DOMAIN=https://us-east-1pgsbc8uit.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=https://sheerwoodadmission.com/

# Email OTP settings. Use an app password or SMTP credentials from your email provider.
# Keep these server-side only; never use VITE_ variables for credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=admissions@example.com

# Optional comma-separated recipients for new-admission notifications. Admin
# users stored in the portal also receive the notification automatically.
ADMISSION_NOTIFICATION_EMAILS=admissions@example.com
