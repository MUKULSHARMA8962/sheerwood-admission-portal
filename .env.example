# Cognito User Pool Hosted UI / Managed Login configuration.
# These values are public browser configuration. Never put an app-client secret in VITE_ variables.
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_PGsbC8UiT
VITE_COGNITO_DOMAIN=https://your-cognito-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=2oii9hos09ek2r06iasb4otbgg

# These must exactly match the Callback URL and Sign-out URL allowed in the Cognito app client.
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPES=email openid phone

# Set only when using a confidential Cognito app client. The secret stays in
# backend/.env; the browser calls this same-origin API endpoint instead.
VITE_COGNITO_TOKEN_EXCHANGE_URL=/api/auth/cognito/token

# Role resolution checks custom:role first, then Cognito groups named parent, student, teacher or admin.
VITE_COGNITO_ROLE_CLAIM=custom:role
VITE_COGNITO_DEFAULT_ROLE=admission
