# Public domain that resolves to this Ubuntu server's public IP address.
DOMAIN=sheerwoodadmission.com

# These values are baked into the React browser build. Never put a client secret here.
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_PGsbC8UiT
VITE_COGNITO_DOMAIN=https://us-east-1pgsbc8uit.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=2oii9hos09ek2r06iasb4otbgg
VITE_COGNITO_REDIRECT_URI=https://sheerwoodadmission.com/
VITE_COGNITO_LOGOUT_URI=https://sheerwoodadmission.com/
VITE_COGNITO_SCOPES=email openid phone
# The browser uses the FastAPI exchange endpoint for a confidential Cognito client.
# The corresponding client secret belongs only in backend/.env.
VITE_COGNITO_TOKEN_EXCHANGE_URL=/api/auth/cognito/token
VITE_COGNITO_ROLE_CLAIM=custom:role
VITE_COGNITO_DEFAULT_ROLE=admission
